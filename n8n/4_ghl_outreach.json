{
  "name": "4 - GHL outreach",
  "nodes": [
    {
      "id": "8f137605-42e9-4fd4-8826-848203964e16",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "de9fb9c2-db66-4e62-b408-43231eade759",
      "name": "Settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Settings for the outreach workflow. Change these to match your setup.\nreturn [{\n  json: {\n    location_id: 'yLiKZKvk2CeI2ckIqd1L',   // the GHL sub-account (location)\n    pipeline_name: 'SG - Candidates',        // the candidate pipeline in GHL\n    outreach_tag: 'sg-outreach',             // adding this tag starts the GHL email sequence\n    // TEST MODE: every candidate's GHL contact gets YOUR inbox with a +tag\n    // (e.g. you+cand12@gmail.com), so no real person is ever emailed while testing.\n    // Set to '' to email candidates at their real address.\n    test_inbox: 'YOUR_EMAIL@gmail.com'\n  }\n}];\n"
      }
    },
    {
      "id": "fd20f97a-79f6-41f1-a0c7-4c34aa917093",
      "name": "Get GHL pipelines",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://services.leadconnectorhq.com/opportunities/pipelines?locationId={{ $json.location_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "98bf845f-8b76-4ac4-b2f9-3e8eec5005e2",
      "name": "Find pipeline",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Find the candidate pipeline and its stage IDs in GHL (names are matched loosely).\nconst s = $('Settings').first().json;\nconst norm = t => String(t || '').toLowerCase().replace(/[^a-z0-9]/g, '');\n\nconst pipeline = ($input.first().json.pipelines || []).find(p => norm(p.name) === norm(s.pipeline_name));\nif (!pipeline) throw new Error(`GHL pipeline \"${s.pipeline_name}\" not found. Create it in GHL (Opportunities > Pipelines) first.`);\n\nconst stages = Object.fromEntries(pipeline.stages.map(st => [norm(st.name), st.id]));\nif (!stages.outreachsent) throw new Error(`The pipeline \"${pipeline.name}\" needs a stage called \"Outreach Sent\".`);\n\nreturn [{\n  json: {\n    pipeline_id: pipeline.id,\n    pipeline_name: pipeline.name,\n    stages: stages,                                                       // \"outreachsent\" -> stage id\n    stage_names: Object.fromEntries(pipeline.stages.map(st => [st.id, st.name]))  // stage id -> \"Outreach Sent\"\n  }\n}];\n"
      }
    },
    {
      "id": "209b3fdd-f626-4ca4-a480-6bb310d64694",
      "name": "Get approved shortlist",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "method": "GET",
        "url": "https://irqnsrfhwinvujxkmsmo.supabase.co/rest/v1/shortlists?select=id,role_id,candidate_id,candidates(full_name,email),roles(title)&stage=eq.approved",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {
          "timeout": 30000
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "f54aefc8-e9d0-4763-8166-683d1d41ecd1",
      "name": "Prepare GHL records",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -100
      ],
      "parameters": {
        "jsCode": "// Turn each newly approved shortlist row into a GHL contact + opportunity.\nconst s = $('Settings').first().json;\nconst info = $('Find pipeline').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.id);   // empty result -> nothing to do\nif (!rows.length) return [];\n// Safety: never send anything until a real test inbox is filled in.\nif (/YOUR_EMAIL/i.test(s.test_inbox)) throw new Error('Open the Settings node and put your own email in test_inbox first.');\n\nconst testEmail = candidateId => {\n  const [user, domain] = s.test_inbox.split('@');\n  return `${user}+cand${candidateId}@${domain}`;\n};\n\nreturn rows.map(r => {\n  const c = r.candidates || {};\n  const fullName = c.full_name || 'Candidate';\n  const [first, ...rest] = fullName.split(' ');\n  return {\n    json: {\n      shortlist_id: r.id,\n      role_id: r.role_id,\n      role_title: (r.roles || {}).title || '',\n      candidate_id: r.candidate_id,\n      name: fullName,\n      contact: {\n        locationId: s.location_id,\n        firstName: first,\n        lastName: rest.join(' '),\n        name: fullName,\n        email: s.test_inbox ? testEmail(r.candidate_id) : c.email,\n        tags: ['sg-candidate', 'sg-role-' + r.role_id],\n        source: 'SG Recruiting Copilot'\n      },\n      opportunity: {\n        pipelineId: info.pipeline_id,\n        locationId: s.location_id,\n        pipelineStageId: info.stages.outreachsent,\n        status: 'open',\n        // The role and candidate ids in the name let us sync stages back to Supabase later.\n        name: `SG - ${fullName} (role ${r.role_id}, candidate ${r.candidate_id})`\n      }\n    }\n  };\n});\n"
      }
    },
    {
      "id": "44c2ff28-e867-45b9-a742-501a4f72500c",
      "name": "Upsert GHL contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/contacts/upsert",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.contact) }}"
      }
    },
    {
      "id": "1bacf638-716b-413a-b1ab-fecc57b33842",
      "name": "Create opportunity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/opportunities/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ...$('Prepare GHL records').item.json.opportunity, contactId: $json.contact.id }) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "1da21744-4b8e-457f-867d-a83c8d89aad3",
      "name": "Add outreach tag",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://services.leadconnectorhq.com/contacts/{{ $('Upsert GHL contact').item.json.contact.id }}/tags",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tags: [$('Settings').first().json.outreach_tag] }) }}"
      }
    },
    {
      "id": "682b4a0b-d949-4faa-b85e-1f65373d672a",
      "name": "Mark contacted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        -100
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=https://irqnsrfhwinvujxkmsmo.supabase.co/rest/v1/shortlists?id=eq.{{ $('Prepare GHL records').item.json.shortlist_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ stage: 'contacted', updated_at: new Date().toISOString() }) }}"
      }
    },
    {
      "id": "279a63d4-d739-486f-bfbd-591c5a10fba1",
      "name": "Save GHL contact id",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        -100
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=https://irqnsrfhwinvujxkmsmo.supabase.co/rest/v1/candidates?id=eq.{{ $('Prepare GHL records').item.json.candidate_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ghl_contact_id: $('Upsert GHL contact').item.json.contact.id }) }}"
      }
    },
    {
      "id": "b5b7eb1c-982f-418c-a84f-ce3f4dc5936e",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        -100
      ],
      "parameters": {
        "jsCode": "// One Slack message for the whole batch instead of one per candidate.\nconst done = $('Prepare GHL records').all().map(i => i.json);\nconst byRole = {};\nfor (const d of done) (byRole[d.role_id] = byRole[d.role_id] || { title: d.role_title, names: [] }).names.push(d.name);\n\nconst lines = Object.entries(byRole).map(([id, r]) => `• Role #${id} (${r.title}): ${r.names.join(', ')}`);\nreturn [{\n  json: {\n    text: `:incoming_envelope: *Outreach started* for ${done.length} candidate${done.length === 1 ? '' : 's'}\\n` +\n      lines.join('\\n') +\n      `\\nThey are in the GHL pipeline (Outreach Sent) and the email sequence has begun. It stops automatically when they reply.`\n  }\n}];\n"
      }
    },
    {
      "id": "276f0108-71b9-4db4-a45c-30775cb3418d",
      "name": "Tell recruiter",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        2640,
        -100
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#recruiting",
          "mode": "name"
        },
        "text": "={{ $json.text }}",
        "otherOptions": {}
      }
    },
    {
      "id": "6840bb7e-a549-4cf5-97d4-18f0a67d924e",
      "name": "Get SG opportunities",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        150
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://services.leadconnectorhq.com/opportunities/search?location_id={{ $('Settings').first().json.location_id }}&pipeline_id={{ $json.pipeline_id }}&limit=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "13236bf7-6d6f-4c7c-bef1-78b5b96d4a4e",
      "name": "Get current stages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        150
      ],
      "parameters": {
        "method": "GET",
        "url": "https://irqnsrfhwinvujxkmsmo.supabase.co/rest/v1/shortlists?select=role_id,candidate_id,stage",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {
          "timeout": 30000
        }
      },
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "id": "eae387f2-65a6-46c1-8584-c742c0099499",
      "name": "Find stage changes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        150
      ],
      "parameters": {
        "jsCode": "// Copy pipeline stages from GHL back to Supabase, so the portal shows where each candidate is.\nconst info = $('Find pipeline').first().json;\nconst norm = t => String(t || '').toLowerCase().replace(/[^a-z0-9]/g, '');\nconst GHL_TO_DB = {\n  approved: 'approved', outreachsent: 'contacted', replied: 'replied', interview: 'interview',\n  submittedtoclient: 'interview', placed: 'placed', notafit: 'rejected'\n};\n\nconst current = new Map($('Get current stages').all().map(i => i.json).filter(r => r.role_id)\n  .map(r => [`${r.role_id}-${r.candidate_id}`, r.stage]));\n\nconst changes = [];\nfor (const o of ($('Get SG opportunities').first().json.opportunities || [])) {\n  const m = String(o.name || '').match(/role (\\d+), candidate (\\d+)/);\n  if (!m) continue;                                         // not created by this workflow\n  const stage = GHL_TO_DB[norm(info.stage_names[o.pipelineStageId])];\n  const key = `${m[1]}-${m[2]}`;\n  if (stage && current.has(key) && current.get(key) !== stage) {\n    changes.push({ json: { role_id: Number(m[1]), candidate_id: Number(m[2]), stage: stage } });\n  }\n}\nreturn changes;\n"
      }
    },
    {
      "id": "30dc72ea-833f-4b6e-84ac-465bbdea9e4e",
      "name": "Update stage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        150
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=https://irqnsrfhwinvujxkmsmo.supabase.co/rest/v1/shortlists?role_id=eq.{{ $json.role_id }}&candidate_id=eq.{{ $json.candidate_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ stage: $json.stage, updated_at: new Date().toISOString() }) }}"
      }
    }
  ],
